{
  "manifest_version": 3,
  "name": "Diigolet 2 Highlighter",
  "version": "0.1.0",
  "description": "Highlight web pages into your Diigo library. Unofficial, small, works on strict sites and never forgets that you are signed in.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Diigolet 2",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "dist/bg.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["dist/content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage", "cookies", "tabs", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://*.diigo.com/*"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "commands": {
    "highlight-selection": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Highlight the selected text in Diigo" },
    "toggle-highlights": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Show or hide the Diigo highlights on this page" }
  }
}
